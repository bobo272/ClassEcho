# Local-only data and queue. Defaults work without this file.
CLASSECHO_REDIS_URL=redis://127.0.0.1:6387/0
# CLASSECHO_DATA_DIR=/absolute/path/to/private/data

# Optional Qwen integration. Leave blank for local transcription/extractive notes.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# No paid requests are started with a zero budget or missing prices.
# Confirm region, currency, context tier and current official prices yourself.
CLASSECHO_BUDGET_CNY=0
QWEN_INPUT_CNY_PER_MILLION=
QWEN_OUTPUT_CNY_PER_MILLION=
